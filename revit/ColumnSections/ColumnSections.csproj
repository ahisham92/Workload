<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2022-2024 run on .NET Framework 4.8. For Revit 2025 and later,
         build with -p:RevitVersion=2025, which switches this to .NET 8. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>
    <AssemblyName>ColumnSections</AssemblyName>
    <RootNamespace>ColumnSections</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The Revit API assemblies ship with Revit; they are referenced from the
       installation and never copied into the output. -->
  <PropertyGroup>
    <RevitPath Condition="'$(RevitPath)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnMissingRevit" BeforeTargets="Build"
          Condition="!Exists('$(RevitPath)\RevitAPI.dll')">
    <Warning Text="RevitAPI.dll not found under $(RevitPath). Pass -p:RevitPath=... or -p:RevitVersion=... ." />
  </Target>

  <!-- Optional: copy the add-in straight into the user's Revit add-ins folder.
       dotnet build -c Release -p:DeployAddin=true -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true'">
    <PropertyGroup>
      <AddinFolder>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(AddinFolder)\ColumnSections" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinFolder)\ColumnSections" />
    <Copy SourceFiles="ColumnSections.addin" DestinationFolder="$(AddinFolder)" />
  </Target>

</Project>
